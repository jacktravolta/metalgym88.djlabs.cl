# Example nginx config for the metalgym88.djlabs.cl static PWA host.
# Packaged, NOT applied to any server (owner constraint; apply is the
# owner's explicit decision). Adjust paths and certbot config to the host.

server {
    listen 443 ssl http2;
    server_name metalgym88.djlabs.cl;

    # Certbot-managed cert for the subdomain.
    ssl_certificate     /etc/letsencrypt/live/metalgym88.djlabs.cl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/metalgym88.djlabs.cl/privkey.pem;

    # Built PWA output (see DEPLOY.md build steps).
    root /var/www/metalgym88;
    index index.html;

    # HTTPS only.
    if ($scheme != "https") {
        return 301 https://$host$request_uri;
    }

    # Immutable hashed assets: cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Service worker and index: ALWAYS revalidated so updates and the
    # deploy knob script reach users on the next visit.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: deep links resolve to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}

server {
    listen 80;
    server_name metalgym88.djlabs.cl;
    # ACME challenges and redirect to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
